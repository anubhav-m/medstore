{
  "name": "medstore",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "mobile/*"
  ],
  "engines": {
    "node": "^22.14.0"
  },
  "scripts": {
    "postinstall": "npm run build:shared",
    "build:shared": "npm run build -w @medstore/shared",
    "dev:shared": "npm run dev -w @medstore/shared",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "knip": "knip",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.0"
  }
}
