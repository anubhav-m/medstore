NODE_ENV=development
PORT=4000
# Must point to a replica set (Atlas does by default) so transactions work
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/medstore?retryWrites=true&w=majority
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the app; 0 locally, at least 1 in production (Render is a proxy)
TRUST_PROXY=0
# Signs customer access tokens. At least 32 random characters; all three secrets must differ.
# Generate with: node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(48))).toString('base64url'))"
JWT_CUSTOMER_ACCESS_SECRET=<at-least-32-random-characters>
# Signs admin access tokens. At least 32 random characters.
JWT_ADMIN_ACCESS_SECRET=<at-least-32-random-characters>
# Keys the HMAC of email/reset codes. At least 32 random characters.
OTP_HMAC_SECRET=<at-least-32-random-characters>
# Google OAuth "Web application" client id (the audience of the apps' Google ID tokens)
GOOGLE_WEB_CLIENT_ID=<client-id>.apps.googleusercontent.com
# Resend API key ("re_…")
EMAIL_API_KEY=re_<resend-api-key>
# "address@domain" or "Name <address@domain>"; the domain must be verified in Resend
EMAIL_FROM=MedStore <no-reply@example.com>
# Supabase project URL without any path (not .../rest/v1/), e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase secret key "sb_secret_…" (Project Settings → API Keys → Secret keys) — never the publishable key
SUPABASE_SECRET_KEY=sb_secret_<secret-key>
# Private bucket for prescription photos; create or update it with: npm run storage:setup
SUPABASE_BUCKET=prescriptions
# Minutes a customer has to confirm a bill (1-1440); a bill sent before closing expires at closing time at the latest
BILL_CONFIRMATION_TIMEOUT_MINUTES=60
# Expo access token for sending push notifications (expo.dev > Account settings > Access tokens).
# Optional, but required once "enhanced push security" is turned on for the Expo project.
EXPO_ACCESS_TOKEN=
