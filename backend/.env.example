NODE_ENV=development
PORT=4000
# Must point to a replica set (Atlas does by default) so transactions work
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/medstore?retryWrites=true&w=majority
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the app; 0 locally
TRUST_PROXY=0
# Signs customer access tokens. At least 32 random characters; must differ from OTP_HMAC_SECRET.
# Generate with: node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(48))).toString('base64url'))"
JWT_CUSTOMER_ACCESS_SECRET=<at-least-32-random-characters>
# Keys the HMAC of email/reset codes. At least 32 random characters.
OTP_HMAC_SECRET=<at-least-32-random-characters>
# Google OAuth "Web application" client id (the audience of the apps' Google ID tokens)
GOOGLE_WEB_CLIENT_ID=<client-id>.apps.googleusercontent.com
# Resend API key
EMAIL_API_KEY=<resend-api-key>
# "address@domain" or "Name <address@domain>"; the domain must be verified in Resend
EMAIL_FROM=MedStore <no-reply@example.com>
