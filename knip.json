{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "shared": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "backend": {
      "project": ["src/**/*.js", "scripts/**/*.js", "test/**/*.js"]
    },
    "mobile/core": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"]
    },
    "mobile/customer": {
      "entry": ["src/config/env.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["expo-updates"]
    },
    "mobile/admin": {
      "entry": [
        "src/config/env.ts",
        "src/features/orders/index.ts",
        "src/features/reports/index.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["expo-updates"]
    }
  }
}
